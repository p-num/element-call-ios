.DS_Store
/.build
/Packages
/*.xcodeproj
# The example harness's project is generated from Example/project.yml by XcodeGen, which is what
# gets reviewed: a pbxproj is forty thousand lines that nobody reads and everybody conflicts on.
Example/*.xcodeproj
# Generated with it, from the `info` block in project.yml.
Example/ElementCallExample/Info.plist
xcuserdata/
DerivedData/
.swiftpm/config/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc
.nova
node_modules

# Make sure the IDETemplateMacros.plist is committed.
!.swiftpm

# Kept local for now: candid notes on gaps in matrix-rust-rtc and the SDK bindings, for those
# owners rather than for consumers of this package. The code does not depend on it: the removal
# checklist for the widget-driver stopgap lives in WidgetMatrixBridge.swift's header, and the
# linker-flag measurement is in the README.
FEEDBACK.md

# The marker that asks the snapshot harness to overwrite what no longer matches.
Tests/ElementCallTests/.record-snapshots

# Left behind by a local rehearsal of scripts/release.sh.
release-notes.md
